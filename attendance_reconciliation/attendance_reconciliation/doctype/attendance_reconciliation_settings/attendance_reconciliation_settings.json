{
  "doctype": "DocType",
  "name": "Attendance Reconciliation Settings",
  "module": "Attendance Reconciliation",
  "issingle": 1,
  "track_changes": 1,
  "engine": "InnoDB",
  "field_order": [
    "enabled",
    "lookback_days",
    "sync_grace_minutes",
    "freeze_through",
    "help"
  ],
  "fields": [
    {
      "fieldname": "enabled",
      "label": "Enable Hourly Reconciliation",
      "fieldtype": "Check",
      "default": "0",
      "description": "Automatically correct eligible absences in the lookback window. Disabled by default."
    },
    {
      "fieldname": "lookback_days",
      "label": "Lookback Days",
      "fieldtype": "Int",
      "default": "30",
      "reqd": 1
    },
    {
      "fieldname": "sync_grace_minutes",
      "label": "Grace Minutes After Actual Shift End",
      "fieldtype": "Int",
      "default": "60",
      "reqd": 1
    },
    {
      "fieldname": "freeze_through",
      "label": "Do Not Change Attendance On or Before",
      "fieldtype": "Date"
    },
    {
      "fieldname": "help",
      "label": "Help",
      "fieldtype": "HTML",
      "options": "<p>Preview first. Historical/manual absences need approval on Attendance. Skipped punches need approval on Employee Checkin. Submitted salary slips and approved leave block corrections. Results appear in Attendance Reconciliation Run.</p>"
    }
  ],
  "permissions": [
    {
      "role": "HR Manager",
      "read": 1,
      "report": 1,
      "export": 1,
      "write": 1,
      "create": 1
    },
    {
      "role": "System Manager",
      "read": 1,
      "report": 1,
      "export": 1,
      "write": 1,
      "create": 1
    }
  ],
  "sort_field": "creation",
  "sort_order": "DESC"
}
